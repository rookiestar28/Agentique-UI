{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentique.local/schemas/agent-evaluation-case.schema.json",
  "title": "Agentique Agent Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "provenance", "adapterId", "timeoutMs", "payload", "expected", "checks", "forbiddenEffects", "digest"],
  "properties": {
    "schemaVersion": { "const": "agentique.agentEvaluationCase.v1" },
    "id": { "type": "string", "pattern": "^fixture\\.[a-z0-9][a-z0-9.-]{0,63}$" },
    "provenance": { "enum": ["repo-owned-inline", "repo-owned-pinned-git"] },
    "adapterId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
    "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario"],
      "properties": { "scenario": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } }
    },
    "expected": { "type": "object" },
    "checks": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string" } },
    "forbiddenEffects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["network", "shell", "user-filesystem", "credential-read"] } },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
